# Copier en `.env` pour le développement local. Ne jamais commiter `.env`.
# Générer les secrets avec : python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Application ---
# development | test | production (production désactive /docs)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Origines autorisées pour CORS, au format JSON. Vide = aucune origine navigateur autorisée.
CORS_ORIGINS=[]

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=freelanceradar
POSTGRES_USER=freelanceradar
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Les tests utilisent automatiquement la base `<POSTGRES_DB>_test` sur le même serveur.
DATABASE_URL=postgresql+psycopg://freelanceradar:change-me@127.0.0.1:5432/freelanceradar

# --- Redis (broker Celery, limitation des tentatives de connexion) ---
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# --- Authentification JWT ---
# Obligatoire, 32 caractères minimum.
JWT_SECRET_KEY=change-me-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Collecte ---
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=5000000

# --- Docker Compose ---
# Port de l'API publié sur 127.0.0.1 par docker-compose.yml.
API_PORT=8000

# --- E-mail (SMTP) ---
# Aucun e-mail n'est envoyé tant que EMAIL_SENDING_ENABLED=false.
# Vérifier la configuration sans rien envoyer : uv run python -m app.cli check-smtp
EMAIL_SENDING_ENABLED=false
SMTP_HOST=mail.example.com
# ssl = TLS direct (port 465) ; starttls = port 587.
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=vous@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=vous@example.com
SMTP_FROM_NAME="Votre Nom"
